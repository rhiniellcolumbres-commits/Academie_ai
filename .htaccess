RewriteEngine On

# Keep clean page URLs without trailing slashes.
RewriteRule ^(login|register|dashboard|assessment|roadmap|lesson|profile|privacy|terms|moderation|copyright)/$ $1 [R=302,L,NE]
RewriteRule ^admin/(login|dashboard|students|setup)/$ admin/$1 [R=302,L,NE]

# Redirect legacy page URLs to their clean equivalents (never redirect form/API requests).
RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$
RewriteCond %{THE_REQUEST} \s/+[^\s?]*\.php(?:[?\s]) [NC]
RewriteRule ^(login|register|dashboard|assessment|roadmap|lesson|profile|privacy|terms|moderation|copyright)\.php$ $1 [R=302,L,NE]
RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$
RewriteCond %{THE_REQUEST} \s/+[^\s?]*\.php(?:[?\s]) [NC]
RewriteRule ^study-path\.php$ roadmap [R=302,L,NE]
RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$
RewriteCond %{THE_REQUEST} \s/+[^\s?]*\.php(?:[?\s]) [NC]
RewriteRule ^privacy-policy\.php$ privacy [R=302,L,NE]
RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$
RewriteCond %{THE_REQUEST} \s/+[^\s?]*\.php(?:[?\s]) [NC]
RewriteRule ^admin/(login|dashboard|students|setup)\.php$ admin/$1 [R=302,L,NE]
RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$
RewriteCond %{THE_REQUEST} \s/+[^\s?]*\.php(?:[?\s]) [NC]
RewriteRule ^index\.php$ ./ [R=302,L]

# Public and student pages.
RewriteRule ^login$ login.php [L,QSA]
RewriteRule ^register$ register.php [L,QSA]
RewriteRule ^dashboard$ dashboard.php [L,QSA]
RewriteRule ^assessment$ assessment.php [L,QSA]
RewriteRule ^roadmap$ study-path.php [L,QSA]
RewriteRule ^lesson$ lesson.php [L,QSA]
RewriteRule ^profile$ profile.php [L,QSA]
RewriteRule ^privacy$ privacy-policy.php [L,QSA]
RewriteRule ^terms$ terms.php [L,QSA]
RewriteRule ^moderation$ moderation.php [L,QSA]
RewriteRule ^copyright$ copyright.php [L,QSA]

# Admin pages.
RewriteRule ^admin/login$ admin/login.php [L,QSA]
RewriteRule ^admin/dashboard$ admin/dashboard.php [L,QSA]
RewriteRule ^admin/students$ admin/students.php [L,QSA]
RewriteRule ^admin/setup$ admin/setup.php [L,QSA]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,L]
